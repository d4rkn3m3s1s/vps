generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmulatorStatus {
  PENDING
  RUNNING
  STOPPED
  FAILED
  DELETED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum JobType {
  EMULATOR_CREATE
  EMULATOR_START
  EMULATOR_STOP
  EMULATOR_DELETE
  EMULATOR_INSTALL_APK
  EMULATOR_SCREENSHOT
  EMULATOR_SHELL
  EMULATOR_OPEN_APP
  EMULATOR_CLOSE_APP
  EMULATOR_PUSH_FILE
  EMULATOR_SET_PROXY
  RPA_RUN
  EMULATOR_SNAPSHOT_CREATE
  EMULATOR_SNAPSHOT_RESTORE
  EMULATOR_RESET
  EMULATOR_PULL_FILE
  EMULATOR_CLIPBOARD_SET
  EMULATOR_CLIPBOARD_GET
  REGISTER_INSTAGRAM
  REGISTER_WHATSAPP
  WHATSAPP_SEND
  WHATSAPP_READ
  WHATSAPP_CONVERSATIONS
  WHATSAPP_RECEIPTS
  WHATSAPP_MEDIA
  WHATSAPP_CALLS
  WHATSAPP_SEARCH
  WHATSAPP_UNREAD
  // More root-DB reads (no UI on the device): full contacts list, group members,
  // per-chat summary stats, and account health (registered number + WA version).
  WHATSAPP_CONTACTS
  WHATSAPP_GROUP_MEMBERS
  WHATSAPP_CHAT_SUMMARY
  WHATSAPP_ACCOUNT_HEALTH
  // Even more root-DB reads: pull downloaded media as base64, emoji reactions,
  // polls, per-recipient read receipts (who-read-in-group), starred messages,
  // and Business labels.
  WHATSAPP_FETCH_MEDIA
  WHATSAPP_REACTIONS
  WHATSAPP_POLLS
  WHATSAPP_READ_BY
  WHATSAPP_STARRED
  WHATSAPP_LABELS
  // Fetch a contact's profile: avatar screenshot (cropped to a data-URI) + name/
  // about/last-seen text scraped from the contact-info screen.
  WHATSAPP_PROFILE
  // Block / unblock a contact from the chat's overflow menu (payload.block bool).
  WHATSAPP_BLOCK
  // Read the Settings › Privacy › Blocked-contacts list off the device.
  WHATSAPP_BLOCKLIST
  // Read the account's OWN WhatsApp number off the device.
  WHATSAPP_MYNUMBER
  // Send a media message (image/file) to a peer.
  WHATSAPP_SEND_MEDIA
  // Delete a message (for me / for everyone).
  WHATSAPP_DELETE_MSG
  // Clear all messages in a chat.
  WHATSAPP_CLEAR_CHAT
  // Send a Telegram message from a device via the tg:// deep link + Send tap.
  TELEGRAM_SEND
  // Register a NEW Telegram account on a device (mirrors REGISTER_WHATSAPP).
  TELEGRAM_REGISTER
  APP_EXPLORE
  AGENT_RUN
  APPLY_FINGERPRINT
  PROVISION_INTEGRITY
  PROVISION_DEVICE
  DEVICE_WAKE
  DEVICE_SLEEP
}

// Lifecycle of an AI Device Agent run (Claude autonomously driving a phone).
enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum HostStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

// A registered KVM/emulator host that runs cloud phones. The install.sh agent
// registers and heartbeats; the dashboard shows capacity and health.
model Host {
  id             String     @id @default(cuid())
  name           String
  address        String
  region         String?
  status         HostStatus @default(OFFLINE)
  capacity       Int        @default(0)
  runningPhones  Int        @default(0)
  cpuCores       Int?
  memoryGb       Int?
  // Live capacity from the agent heartbeat (df / free). Used to show "how many
  // more devices fit" — each Waydroid instance needs ~8GB disk + ~1.5GB RAM.
  diskTotalGb    Int?
  diskFreeGb     Int?
  ramFreeGb      Int?
  // 1-minute load average from the agent heartbeat. Combined with cpuCores it
  // gives CPU saturation (load / cores) — the dashboard warns when this is high
  // so an operator can sleep idle devices (software-rendered Waydroid pins CPU).
  loadAvg1m      Float?
  kvm            Boolean    @default(true)
  agentKeyHash   String?
  lastSeenAt     DateTime?
  // Cloud provider this host was provisioned from (e.g. "vast"), and the
  // provider-side instance/contract id so we can manage (destroy) it later.
  provider       String?
  vastInstanceId String?
  // Hourly USD cost locked at provision time (e.g. Vast.ai dph_total) so the cost
  // panel can compute total GPU spend without re-querying the provider.
  costPerHour    Float?
  workspaceId    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  devices        Device[]
  claimedJobs    Job[]
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  // agentKeyHash is resolved on the hottest auth path: every /agent/jobs/next
  // long-poll (~2s/host), every heartbeat, and every agent WS connect look the host
  // up by sha256(agentKey). Without this index each was a sequential Host scan.
  @@index([agentKeyHash])
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  STARTING
  STOPPING
  ERROR
  UPDATING
  REBOOTING
}

enum SocialProvider {
  X
  META
  INSTAGRAM
}

enum ProxyType {
  HTTP
  HTTPS
  SOCKS5
}

enum ProxyStatus {
  UNKNOWN
  OK
  FAILED
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  passwordHash         String
  role                 String            @default("admin")
  // Two-factor auth (TOTP). Secret is stored AES-256-GCM encrypted; backup
  // codes are stored as sha256 hashes (one-time use).
  twoFactorEnabled     Boolean           @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]          @default([])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  refreshTokens        RefreshToken[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  socialAccounts       SocialAccount[]
  memberships          WorkspaceMember[]
}

// A tenant boundary. Every fleet resource (devices, proxies, jobs, …) belongs to
// exactly one workspace; members access only their workspaces.
model Workspace {
  id                    String                @id @default(cuid())
  name                  String
  slug                  String                @unique
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  members               WorkspaceMember[]
  subscription          Subscription?
  devices               Device[]
  deviceGroups          DeviceGroup[]
  proxies               Proxy[]
  jobs                  Job[]
  rpaFlows              RpaFlow[]
  schedules             ScheduledTask[]
  farmCampaigns         FarmCampaign[]
  farmAccounts          FarmAccount[]
  webhooks              Webhook[]
  hosts                 Host[]
  resourceGuides        ResourceGuide[]
  socialAccounts        SocialAccount[]
  alertRules            AlertRule[]
  alertEvents           AlertEvent[]
  snapshots             DeviceSnapshot[]
  scheduledPosts        ScheduledPost[]
  generatedAccounts     GeneratedAccount[]
  settings              WorkspaceSettings?
  notificationChannels  NotificationChannel[]
  agentRuns             AgentRun[]
  appMaps               AppMap[]
  whatsappLabels        WhatsappLabel[]
  whatsappCannedReplies WhatsappCannedReply[]
}

// Per-workspace outbound notification channel (Telegram / Slack / Discord).
// The config (bot token / webhook url / chat id) is AES-encrypted at rest.
model NotificationChannel {
  id           String    @id @default(cuid())
  workspaceId  String
  type         String // "telegram" | "slack" | "discord"
  configEnc    String // AES-256-GCM encrypted JSON
  active       Boolean   @default(true)
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type])
  @@index([workspaceId])
}

// One-to-one policy/configuration row for a workspace. Persisted security
// policies that the API enforces (require2fa, restrictInvites) plus advisory
// preferences surfaced in the admin UI.
model WorkspaceSettings {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  require2fa       Boolean   @default(false)
  restrictInvites  Boolean   @default(true)
  strongPasswords  Boolean   @default(true)
  sessionExpiryHrs Int       @default(12)
  // Vast.ai GPU-host provider API key (AES-GCM encrypted; never returned raw).
  vastApiKey       String?
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Join table: which user belongs to which workspace, with what role.
model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("operator") // admin | operator | viewer
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum AlertTrigger {
  JOB_FAILED
  DEVICE_OFFLINE
  QUOTA_HIGH
  HOST_OFFLINE
  FARM_BAN_RISK
}

// A user-defined alerting rule, scoped to a workspace. When its trigger
// condition occurs the engine creates an AlertEvent and optionally notifies.
model AlertRule {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  trigger     AlertTrigger
  // Optional threshold (e.g. quota percent for QUOTA_HIGH). 0 = not used.
  threshold   Int          @default(0)
  notify      Boolean      @default(true) // push to the notification center
  webhook     Boolean      @default(false) // also fire outbound webhooks
  email       Boolean      @default(false) // also email workspace admins
  active      Boolean      @default(true)
  lastFiredAt DateTime?
  fireCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events      AlertEvent[]

  @@index([workspaceId])
}

// A recorded firing of an alert rule.
model AlertEvent {
  id           String    @id @default(cuid())
  ruleId       String
  workspaceId  String
  title        String
  detail       String
  acknowledged Boolean   @default(false)
  createdAt    DateTime  @default(now())
  rule         AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([ruleId])
}

// Billing state for a workspace. `plan` is one of the keys in billing.plans.ts
// (free | pro | scale). Stripe identifiers link to the test-mode customer +
// subscription; null while on the free plan.
model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  plan                 String             @default("free")
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id           String    @id @default(cuid())
  userId       String?
  workspaceId  String?
  keyPrefix    String    @unique
  keyHash      String    @unique
  name         String
  scopes       String[]  @default([])
  // AES-256-GCM encrypted plaintext of the key. Populated ONLY for the special
  // per-workspace "API Dokümantasyonu" key, so the docs page can show a real,
  // copy-pasteable key in its curl examples. Never set for user-created keys —
  // those remain hash-only and are shown in plaintext exactly once at creation.
  docPlaintext String?
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// Idempotency-Key store for the public API's on-device write endpoints (send /
// bulk-send). A first request carrying an `Idempotency-Key` header records the
// resulting jobId here; a replay with the SAME key returns that stored jobId
// instead of dispatching a second device job. The (workspaceId, key) unique index
// is the concurrency chokepoint — a racing replay loses the INSERT and reads the
// winner's jobId back. Keys are short-lived (swept on a TTL).
model IdempotencyKey {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  // The endpoint/scope this key was first bound to (e.g. "whatsapp.send"). Replaying
  // the same key against a DIFFERENT endpoint is a misuse and is rejected.
  scope       String
  // The job this key produced. Set once the job row exists; poll it via
  // GET /public/v1/jobs/{jobId}.
  jobId       String?
  createdAt   DateTime @default(now())

  @@unique([workspaceId, key])
  @@index([createdAt])
}

model Emulator {
  id          String         @id @default(cuid())
  name        String
  image       String
  status      EmulatorStatus @default(PENDING)
  containerId String?        @unique
  adbHost     String?
  adbPort     Int?
  metadata    Json?
  createdById String?
  workspaceId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  jobs        Job[]

  @@index([workspaceId])
}

model DeviceGroup {
  id          String         @id @default(cuid())
  name        String
  description String?
  workspaceId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  devices     Device[]
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns   FarmCampaign[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Device {
  id             String       @id @default(cuid())
  uuid           String       @unique @default(cuid())
  name           String
  status         DeviceStatus @default(OFFLINE)
  ipAddress      String?
  adbPort        Int?
  androidVersion String?
  cpuUsage       Float        @default(0)
  memoryUsage    Float        @default(0)
  diskUsage      Float        @default(0)
  lastSeen       DateTime?
  metadata       Json?
  // Free-form operator labels for smart filtering (e.g. "warmup", "us-geo", "vip").
  tags           String[]     @default([])
  groupId        String?
  hostId         String?
  workspaceId    String?
  // The proxy this device's traffic is routed through (redsocks/transparent).
  // Persisted so the panel can show + change a device's proxy; the actual routing
  // is applied host-side by wd-proxy.sh via an EMULATOR_SET_PROXY job.
  proxyId        String?
  // Optional vendor-side phone id (retained for external references).
  externalId     String?
  // Protected devices refuse destructive ops (delete / reset / snapshot-restore /
  // data-wipe). Set for valuable phones (e.g. one holding an active WhatsApp
  // account) so an accidental delete/reset can't wipe the account. Enforced in
  // deleteDevice / resetDevice / restoreSnapshot.
  protected      Boolean      @default(false)
  // External ADB access (TCP bridge). When exposed, the host agent forwards the
  // device's ADB to a public host:port, optionally restricted to an IP allowlist.
  adbExposed     Boolean      @default(false)
  adbPublicHost  String?
  adbPublicPort  Int?
  adbAllowlist   String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  group          DeviceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  host           Host?        @relation(fields: [hostId], references: [id], onDelete: SetNull)
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proxy          Proxy?       @relation(fields: [proxyId], references: [id], onDelete: SetNull)

  // Anti-detection device fingerprint (one per cloud phone).
  fingerprint           DeviceFingerprint?
  schedules             ScheduledTask[]
  farmAccount           FarmAccount?
  snapshots             DeviceSnapshot[]       @relation("DeviceSnapshotSource")
  grants                DeviceGrant[]          @relation("DeviceGrants")
  agentRuns             AgentRun[]
  appMaps               AppMap[]
  metricPoints          DeviceMetricPoint[]
  whatsappMessages      WhatsappMessage[]
  whatsappConversations WhatsappConversation[]

  @@index([workspaceId])
  // Agent hot-path: claimNext/heartbeat/metrics/inbound all query by hostId every
  // ~2s per host. farm.tick + calendar.resolveDevices query by groupId every 60s.
  @@index([hostId])
  @@index([groupId])
}

// Lightweight per-device resource timeseries (CPU/mem/disk %), appended each time
// the host agent reports metrics. Powers the per-device health charts. Kept small
// via a retention prune (see metricsService) so the table never grows unbounded.
model DeviceMetricPoint {
  id          String   @id @default(cuid())
  deviceId    String
  cpuUsage    Float    @default(0)
  memoryUsage Float    @default(0)
  diskUsage   Float    @default(0)
  capturedAt  DateTime @default(now())
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, capturedAt])
  // Retention prune deletes rows older than a cutoff across all devices.
  @@index([capturedAt])
}

// One autonomous run of the AI Device Agent: Claude reads the screen and drives
// the phone toward a natural-language goal over a perceive→decide→act loop. The
// per-turn detail lives in AgentRunStep so the dashboard can replay the run.
model AgentRun {
  id          String         @id @default(cuid())
  goal        String
  deviceId    String
  workspaceId String?
  userId      String?
  status      AgentRunStatus @default(RUNNING)
  stealth     Boolean        @default(false)
  useVision   Boolean        @default(false)
  maxTurns    Int            @default(15)
  turnsUsed   Int            @default(0)
  success     Boolean?
  summary     String?
  error       String?
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?
  device      Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       AgentRunStep[]

  @@index([workspaceId])
  @@index([deviceId])
}

// A single turn of an AgentRun: the screen the model saw, the tool call(s) it
// chose, and the outcome.
model AgentRunStep {
  id         String   @id @default(cuid())
  runId      String
  index      Int
  screenTree String
  screenshot String?
  toolCalls  Json
  result     Json?
  createdAt  DateTime @default(now())
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// A screen-graph of an app, produced by the BFS APP_EXPLORE crawl. The graph is
// stored whole (screens + edges) for visualization; one row per crawl.
model AppMap {
  id          String     @id @default(cuid())
  deviceId    String
  workspaceId String?
  packageName String
  graph       Json
  screenCount Int        @default(0)
  createdAt   DateTime   @default(now())
  device      Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([deviceId])
}

// A randomized hardware/identity fingerprint bound to a single cloud phone so
// each profile looks like a distinct physical device.
model DeviceFingerprint {
  id           String   @id @default(cuid())
  deviceId     String   @unique
  imei         String
  androidId    String
  serialNo     String
  macAddress   String
  manufacturer String
  model        String
  brand        String
  osVersion    String
  buildNumber  String
  resolution   String
  dpi          Int
  carrier      String
  mcc          String
  mnc          String
  phoneNumber  String?
  language     String   @default("en")
  // GPS / SIM geolocation simulation.
  country      String   @default("US")
  countryCode  String   @default("US")
  timezone     String   @default("America/New_York")
  latitude     Float?
  longitude    Float?
  gpsEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Job {
  id              String     @id @default(cuid())
  emulatorId      String?
  // First-class copy of payload.deviceId. The device a job targets was only ever
  // stored inside the JSON payload, so the device-idle guard + agent claim had to
  // filter on a JSON path (payload.deviceId) that no index can serve. This column
  // is populated by createJobRecord and indexed so those hot paths use an index
  // seek instead of scanning PENDING/RUNNING jobs.
  deviceId        String?
  type            JobType
  status          JobStatus  @default(PENDING)
  payload         Json
  result          Json?
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  claimedByHostId String?
  claimedAt       DateTime?
  workspaceId     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  emulator        Emulator?  @relation(fields: [emulatorId], references: [id], onDelete: SetNull)
  claimedBy       Host?      @relation(fields: [claimedByHostId], references: [id], onDelete: SetNull)
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  // The host agent polls for claimable work (status=PENDING, claimedByHostId=null,
  // oldest first) every ~2s; this composite index turns that hot path from a full
  // table scan into an index seek as the job history grows.
  @@index([status, claimedByHostId, createdAt])
  // Newest-jobs-per-workspace list query (orderBy createdAt desc).
  @@index([workspaceId, createdAt])
  // Device-exclusive-job guard (assertDeviceIdle) + agent claim filter by the
  // target device; index status too so "active exclusive job for this device" is
  // an index-only lookup.
  @@index([deviceId, status])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  requestId    String?
  ip           String?
  userAgent    String?
  metadata     Json?
  workspaceId  String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  // Audit list is workspace-scoped and ordered by createdAt desc.
  @@index([workspaceId, createdAt])
}

model SocialAccount {
  id                String         @id @default(cuid())
  provider          SocialProvider
  providerAccountId String
  userId            String
  displayName       String?
  username          String?
  accessTokenEnc    String
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  scopes            String[]       @default([])
  metadata          Json?
  workspaceId       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([workspaceId])
  // listSocialAccountsForUser filters by userId — the model's primary access
  // pattern — which had no leading index (only workspaceId + the composite unique).
  @@index([userId])
}

// FAQ / how-to entries shown on the Resources page. DB-backed so operators can
// curate their own help content per workspace instead of it being hardcoded.
model ResourceGuide {
  id          String     @id @default(cuid())
  question    String
  answer      String
  sortOrder   Int        @default(0)
  workspaceId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Proxy {
  id            String      @id @default(cuid())
  label         String
  type          ProxyType   @default(HTTP)
  host          String
  port          Int
  username      String?
  // Encrypted at rest (AES-256-GCM). Never returned to clients in plaintext.
  password      String?
  group         String?
  isp           String?
  remarks       String?
  exportIp      String?
  // ISO country code for geo-matching a proxy to a device's locale (e.g. assign
  // a US exit to a US-fingerprinted phone). Set on import or detected on check.
  countryCode   String?
  status        ProxyStatus @default(UNKNOWN)
  // Rolling health: 0-100 score (decays on failure, recovers on success),
  // consecutive failCount, and when the next periodic re-check is due. autoAssign
  // prefers higher-scored proxies; the revalidation ticker re-checks checksDue ones.
  score         Int         @default(50)
  failCount     Int         @default(0)
  checksDue     DateTime?
  lastCheckedAt DateTime?
  workspaceId   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  workspace     Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  devices       Device[]

  @@index([workspaceId])
  @@index([checksDue])
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ScheduleRepeat {
  ONCE
  HOURLY
  DAILY
  WEEKLY
}

// A recurring or one-off automation task bound to a cloud phone.
model ScheduledTask {
  id          String         @id @default(cuid())
  name        String
  deviceId    String?
  jobType     JobType
  payload     Json
  repeat      ScheduleRepeat @default(ONCE)
  status      ScheduleStatus @default(ACTIVE)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  runCount    Int            @default(0)
  workspaceId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  device      Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  // scheduler.runDue scans ACTIVE tasks whose nextRunAt has passed every 60s.
  @@index([status, nextRunAt])
}

// Per-account engagement metrics powering the AI Analytics dashboard.
model ContentMetric {
  id        String   @id @default(cuid())
  accountId String?
  provider  String
  date      DateTime @default(now())
  posts     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  followers Int      @default(0)
  reach     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([provider, date])
}

// Installable app in the Applications catalog.
model AppCatalogItem {
  id          String   @id @default(cuid())
  name        String
  packageName String   @unique
  version     String
  category    String   @default("Social")
  shortLabel  String
  color       String   @default("#3a4256")
  iconUrl     String?
  apkUrl      String?
  installs    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A visual RPA automation flow: an ordered list of steps (tap/type/wait/swipe/
// open-app/shell) that can be dispatched as a job to one or more cloud phones.
model RpaFlow {
  id              String         @id @default(cuid())
  name            String
  description     String?
  steps           Json           @default("[]")
  runCount        Int            @default(0)
  lastRunAt       DateTime?
  workspaceId     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  workspace       Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns       FarmCampaign[]
  earlyCampaigns  FarmCampaign[] @relation("FarmEarlyFlow")
  midCampaigns    FarmCampaign[] @relation("FarmMidFlow")
  matureCampaigns FarmCampaign[] @relation("FarmMatureFlow")

  @@index([workspaceId])
}

// ── Farm system ─────────────────────────────────────────────────────────────
// A farm campaign runs an RPA flow across a target device group on a humanized
// schedule to age/warm up the accounts on those cloud phones.
enum FarmStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model FarmCampaign {
  id                 String          @id @default(cuid())
  name               String
  status             FarmStatus      @default(ACTIVE)
  rpaFlowId          String?
  groupId            String?
  // Humanization: each device runs the flow at a random interval between these
  // bounds, capped at maxActionsPerDay, only within [activeFromHour, activeToHour).
  minIntervalMin     Int             @default(45)
  maxIntervalMin     Int             @default(180)
  maxActionsPerDay   Int             @default(20)
  activeFromHour     Int             @default(8)
  activeToHour       Int             @default(23)
  jitterPct          Int             @default(25)
  // Safety: rotate a proxy from the pool onto the device before each run, and
  // auto-pause a device whose health drops below this threshold (ban defense).
  rotateProxy        Boolean         @default(false)
  autoPauseThreshold Int             @default(40)
  // Stage-aware warmup: optional override flows for early/mid/mature accounts.
  // When set, the engine picks the flow that matches a device's warmup stage
  // instead of the default rpaFlow (gentle behavior early, richer behavior late).
  earlyFlowId        String? // stages 1-2 (new / warming)
  midFlowId          String? // stage 3 (developing)
  matureFlowId       String? // stages 4-5 (active / mature)
  // Engine bookkeeping.
  nextRunAt          DateTime        @default(now())
  lastRunAt          DateTime?
  runCount           Int             @default(0)
  workspaceId        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  rpaFlow            RpaFlow?        @relation(fields: [rpaFlowId], references: [id], onDelete: SetNull)
  earlyFlow          RpaFlow?        @relation("FarmEarlyFlow", fields: [earlyFlowId], references: [id], onDelete: SetNull)
  midFlow            RpaFlow?        @relation("FarmMidFlow", fields: [midFlowId], references: [id], onDelete: SetNull)
  matureFlow         RpaFlow?        @relation("FarmMatureFlow", fields: [matureFlowId], references: [id], onDelete: SetNull)
  group              DeviceGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  workspace          Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs               FarmActionLog[]

  @@index([workspaceId])
  // farm.tick scans ACTIVE campaigns whose nextRunAt has passed every 60s.
  @@index([status, nextRunAt])
}

// Per-device warmup / account-maturity tracking. One row per cloud phone that
// participates in farming.
model FarmAccount {
  id                String          @id @default(cuid())
  deviceId          String          @unique
  warmupStage       Int             @default(1) // 1=new … 5=mature
  daysActive        Int             @default(0)
  actionsToday      Int             @default(0)
  totalActions      Int             @default(0)
  healthScore       Int             @default(100) // 0-100; drops on errors
  consecutiveErrors Int             @default(0) // resets on a clean run
  paused            Boolean         @default(false) // auto-paused by ban defense
  pausedReason      String?
  lastActionAt      DateTime?
  dayAnchor         DateTime        @default(now()) // when actionsToday was last reset
  // ── Proactive ban-risk scoring ──
  // 0-100 leading indicator (errors, velocity, proxy/stage mismatch). Persisted
  // so the engine can detect a *rising* trend and alert once per cooldown rather
  // than re-firing every tick while the device stays risky.
  riskScore         Int             @default(0)
  riskAlertedAt     DateTime?
  // ── Account identity (the credentials being warmed up) ──
  // Which platform this account lives on, the public handle, and the secrets.
  // Secrets are AES-256-GCM encrypted at rest and NEVER returned to clients raw.
  platform          String? // x | instagram | meta | tiktok | other
  username          String?
  emailAddress      String?
  passwordEnc       String? // encrypted
  emailPasswordEnc  String? // encrypted (recovery mailbox)
  totpSecretEnc     String? // encrypted 2FA seed
  // Operator notes + free-form tags for filtering ("aged", "buyer", "us-geo").
  notes             String?
  tags              String[]        @default([])
  workspaceId       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  device            Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  workspace         Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs              FarmActionLog[]

  @@index([workspaceId])
}

// Append-only timeline of what each farm account actually did. Written by the
// engine (dispatch) and the job pipeline (outcome), and rendered as a per-account
// audit trail so a ban can be traced back to "what were the last N actions".
model FarmActionLog {
  id          String        @id @default(cuid())
  deviceId    String
  campaignId  String?
  flowId      String?
  flowName    String?
  // dispatch | success | failure | paused | resumed | proxy_rotated | manual
  kind        String
  detail      String?
  warmupStage Int           @default(0)
  healthAfter Int?
  workspaceId String?
  createdAt   DateTime      @default(now())
  account     FarmAccount?  @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  campaign    FarmCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  // Composite index for getHealthTrend / listActionLog: filter by device + order
  // by time. FarmActionLog grows fast (a row per farm tick), so the plain
  // deviceId index alone forces a sort on createdAt.
  @@index([deviceId, createdAt])
  @@index([campaignId])
  @@index([workspaceId])
}

// Inbound + outbound WhatsApp messages for a device/account. Inbound rows are
// written by the host agent's notification poll (POST /agent/whatsapp/inbound);
// outbound rows are written when a WHATSAPP_SEND job completes. Surfaced via the
// messages API, a live WS event, a webhook, and a Telegram/Slack/Discord ping.
model WhatsappMessage {
  id          String   @id @default(cuid())
  workspaceId String?
  deviceId    String
  // IN (received) | OUT (sent by us)
  direction   String   @default("IN")
  // The other party — phone number (E.164-ish) or contact/sender display name.
  peer        String
  body        String
  // Inbound messages start unread; the operator marks a conversation read.
  read        Boolean  @default(false)
  // Outbound delivery state: QUEUED | SENT | DELIVERED | READ | FAILED.
  // Inbound rows are always 'DELIVERED' (we received them). Set on job-complete.
  status      String   @default("SENT")
  statusAt    DateTime @default(now())
  // Populated on FAILED: the agent's reason (INVALID_RECIPIENT, COMPOSE_FAILED…).
  failReason  String?
  // Idempotency key for inbound rows (sha256 of device+peer+body+ts). A duplicate
  // agent push (retry/restart) hits the unique index instead of double-counting.
  dedupeKey   String?  @unique
  // WhatsApp's own timestamp (ms epoch) when known; else server receive time.
  waTimestamp DateTime @default(now())
  createdAt   DateTime @default(now())
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, deviceId, createdAt])
  @@index([deviceId, createdAt])
  // Fast per-conversation history (device + peer, newest first).
  @@index([deviceId, peer, createdAt])
  // Stats/analytics: direction + time windows per workspace.
  @@index([workspaceId, direction, createdAt])
}

// One row per (device, peer) chat thread — the WhatsApp-Web-style conversation
// list. Upserted every time a message is stored (in agent.service). Holds the
// denormalised last-message preview + unread count so the 200+ chat list renders
// without scanning WhatsappMessage. Labels/favourite/archive are operator state.
model WhatsappConversation {
  id              String    @id @default(cuid())
  workspaceId     String?
  deviceId        String
  // The other party (same value as WhatsappMessage.peer).
  peer            String
  // Denormalised preview of the newest message in this thread.
  lastMessageBody String    @default("")
  // 'IN' | 'OUT' — direction of the last message (for the ✓ / arrow in the list).
  lastDirection   String    @default("IN")
  lastMessageAt   DateTime  @default(now())
  // Denormalised delivery state of the last OUTbound message (for the list tick).
  lastStatus      String    @default("SENT")
  // Unread inbound count; reset to 0 when the operator opens the thread.
  unreadCount     Int       @default(0)
  favorite        Boolean   @default(false)
  archived        Boolean   @default(false)
  // Pinned threads sort to the very top of the list (distinct from favourite).
  pinned          Boolean   @default(false)
  pinnedAt        DateTime?
  // Operator-set contact info: a friendly name shown instead of the raw number,
  // and free-text notes (a lightweight CRM). displayName is plaintext (shown in
  // lists); notes are AES-256-GCM encrypted at rest like message bodies.
  displayName     String?
  notes           String?
  // Operator-assigned label ids (see WhatsappLabel). Postgres text[].
  labelIds        String[]  @default([])
  // Whether this contact is currently blocked on the device (set by WHATSAPP_BLOCK
  // and reconciled from WHATSAPP_BLOCKLIST). The list dims blocked threads and the
  // action toggles to "Engeli kaldır".
  blocked         Boolean   @default(false)
  // Cropped avatar as a data-URI ("data:image/png;base64,…"), captured by
  // WHATSAPP_PROFILE off the contact-info screen. Null = fall back to initials.
  avatarBase64    String?
  // When the avatar was last refreshed (so the UI can re-fetch stale ones).
  avatarAt        DateTime?
  // Scraped profile text: { profileName?, about?, phone?, lastSeen? }. Plaintext
  // (not secret) — shown in the contact-info panel.
  profileInfo     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, peer])
  @@index([workspaceId, deviceId, lastMessageAt])
  @@index([deviceId, lastMessageAt])
  // Filtered-list hot paths (archived/pinned views over 200+ threads).
  @@index([deviceId, archived, pinned, lastMessageAt])
}

// Workspace-scoped conversation label/category (name + colour). Assigned to
// conversations by id (WhatsappConversation.labelIds). Deleting a label leaves
// stale ids on conversations — the service filters them out on read.
model WhatsappLabel {
  id          String     @id @default(cuid())
  workspaceId String?
  name        String
  // A short colour token the UI maps to a chip style (e.g. "emerald", "rose").
  color       String     @default("slate")
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Saved reply / message template. Operators insert these into the composer (or
// send them straight from Telegram) with one tap. `shortcut` lets a "/fiyat"
// style trigger expand to the body. Body is plaintext (not a secret).
model WhatsappCannedReply {
  id          String     @id @default(cuid())
  workspaceId String?
  // Optional "/slug" trigger; unique-ish per workspace but not DB-enforced.
  shortcut    String?
  title       String
  body        String
  // Ordering hint for the picker (lower = higher).
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// A one-to-many broadcast: send the same message to many peers on one device,
// throttled with jitter to blunt ban risk. Each send becomes a WHATSAPP_SEND job;
// this row tracks aggregate progress for the UI.
model WhatsappBroadcast {
  id          String   @id @default(cuid())
  workspaceId String?
  deviceId    String
  // Multi-device fan-out: when set, recipients are sharded round-robin across these
  // devices so different phones send in PARALLEL (agent runs one job per device
  // concurrently). deviceId stays as the primary/first device for back-compat.
  deviceIds   String[] @default([])
  message     String
  // Snapshot of the recipient peers at launch time (Postgres text[]).
  peers       String[] @default([])
  total       Int      @default(0)
  sentCount   Int      @default(0)
  failCount   Int      @default(0)
  // How many recipient jobs have been dispatched so far — lets a restart resume
  // dispatch from where it left off instead of stranding the rest (persist/resume).
  dispatchedCount Int  @default(0)
  // QUEUED | RUNNING | COMPLETED | CANCELLED
  status      String   @default("QUEUED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([deviceId])
  @@index([status])
}

enum WebhookEvent {
  JOB_COMPLETED
  JOB_FAILED
  DEVICE_ONLINE
  DEVICE_OFFLINE
  QUOTA_HIGH
  ALERT_FIRED
  WHATSAPP_MESSAGE
  WHATSAPP_SENT
  WHATSAPP_FAILED
  // Registration/provision lifecycle — so integrators can react to the two flagship
  // async flows without poll loops (register/provision were poll-only before).
  WHATSAPP_AWAITING_OTP
  WHATSAPP_REGISTERED
  WHATSAPP_REGISTER_FAILED
  DEVICE_PROVISIONED
  // Outbound delivery receipts: DELIVERED = double-tick (reached the peer's phone),
  // READ = blue-tick. Fired when the agent reads the tick state off a sent bubble
  // and advances the message status (see whatsapp.service.advanceOutboundReceipt).
  WHATSAPP_DELIVERED
  WHATSAPP_READ
  WHATSAPP_CONVERSATIONS
  WHATSAPP_RECEIPTS
  WHATSAPP_MEDIA
  WHATSAPP_CALLS
  WHATSAPP_SEARCH
  WHATSAPP_UNREAD
  // Account health transition detected on-device: an ACTIVE account became
  // RESTRICTED (in review / rate-limited), BANNED (suspended), or LOGGED_OUT.
  // Payload carries { deviceId, phoneNumber, health, note }.
  WHATSAPP_ACCOUNT_HEALTH
  ALL
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// Outbound webhook: POSTs a JSON payload to `url` when a matching event fires.
model Webhook {
  id          String            @id @default(cuid())
  label       String
  url         String
  event       WebhookEvent      @default(ALL)
  secret      String?
  active      Boolean           @default(true)
  lastFiredAt DateTime?
  failCount   Int               @default(0)
  workspaceId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([workspaceId])
}

// One delivery attempt-set for a single event to a single webhook. The queue
// retries on failure (backoff); each terminal outcome is recorded here for the
// delivery-history UI and manual redelivery.
model WebhookDelivery {
  id           String                @id @default(cuid())
  webhookId    String
  event        WebhookEvent
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?
  error        String?
  createdAt    DateTime              @default(now())
  deliveredAt  DateTime?
  webhook      Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
}

// Restricts a member's access to specific device groups (profile-level perms).
model ProfilePermission {
  id         String   @id @default(cuid())
  userId     String
  groupId    String?
  deviceId   String?
  canView    Boolean  @default(true)
  canControl Boolean  @default(false)
  canDelete  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, groupId, deviceId])
}

// ── Device snapshots / image market ─────────────────────────────────────────
// A captured backup of a cloud phone's state (its /data, or a docker image ref)
// that can be restored onto the same device, cloned onto a new one, or published
// to the image market for the whole workspace (or publicly) to provision from.
enum SnapshotVisibility {
  PRIVATE // only the creator
  WORKSPACE // anyone in the workspace
  PUBLIC // listed in the public image market
}

enum SnapshotStatus {
  PENDING // capture job dispatched, not yet ready
  READY // captured and restorable
  FAILED // capture failed
}

model DeviceSnapshot {
  id             String             @id @default(cuid())
  name           String
  description    String?
  // Where the captured artifact lives on the host (tarball path or docker image
  // tag). The agent writes this back when the capture job completes.
  artifactRef    String?
  sizeBytes      BigInt             @default(0)
  androidVersion String?
  // Snapshot of the source device's fingerprint/app set for the market card.
  metadata       Json?
  tags           String[]           @default([])
  visibility     SnapshotVisibility @default(PRIVATE)
  status         SnapshotStatus     @default(PENDING)
  installs       Int                @default(0) // how many devices provisioned from it
  sourceDeviceId String?
  workspaceId    String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sourceDevice   Device?            @relation("DeviceSnapshotSource", fields: [sourceDeviceId], references: [id], onDelete: SetNull)
  workspace      Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([visibility])
}

// ── Device authorization / transfer ─────────────────────────────────────────
// A time-boxed grant of access to a device for another user (think "lend this
// phone to a teammate for 24h"). Distinct from ProfilePermission (which is a
// standing workspace ACL); a grant is temporary, revocable, and audited.
enum GrantAccess {
  VIEW // live screen only
  CONTROL // screen + remote input + jobs
}

model DeviceGrant {
  id          String      @id @default(cuid())
  deviceId    String
  grantedToId String // user receiving access
  grantedById String // user who issued it
  access      GrantAccess @default(VIEW)
  expiresAt   DateTime? // null = no expiry (until revoked)
  revokedAt   DateTime?
  workspaceId String?
  createdAt   DateTime    @default(now())
  device      Device      @relation("DeviceGrants", fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([grantedToId])
}

// ── Content calendar / scheduled posting ────────────────────────────────────
// A piece of content scheduled to be posted from one or more cloud phones at a
// future time. The scheduler tick dispatches the matching RPA flow with the
// content (caption + media) injected when scheduledFor passes.
enum ScheduledPostStatus {
  SCHEDULED
  POSTING
  POSTED
  FAILED
  CANCELED
}

model ScheduledPost {
  id           String              @id @default(cuid())
  caption      String
  platform     String // tiktok | instagram | x | meta | youtube | other
  mediaUrl     String? // image/video asset to push then post
  // Target: a device group (fan out to all) and/or explicit device ids, plus the
  // RPA flow that performs the actual posting steps on each device.
  groupId      String?
  deviceIds    String[]            @default([])
  rpaFlowId    String?
  scheduledFor DateTime
  status       ScheduledPostStatus @default(SCHEDULED)
  postedAt     DateTime?
  error        String?
  workspaceId  String?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  workspace    Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status, scheduledFor])
}

// Account farm — accounts being auto-created in batches. Tracks the full
// provisioning lifecycle: a fake identity + a disposable inbox + a rented phone
// number + the OTP, then the on-device registration via RPA. Secrets are
// AES-256-GCM encrypted at rest and never returned raw to clients.
enum GeneratedAccountStatus {
  PENDING // queued, nothing done yet
  IDENTITY_READY // fake identity generated
  CONTACT_READY // email + phone number provisioned
  AWAITING_OTP // number rented, waiting for the SMS code
  REGISTERING // on-device RPA registration in progress
  ACTIVE // account created successfully
  AWAITING_MANUAL // created but blocked on a human step (IG captcha / SMS wall)
  FAILED // gave up (no OTP, RPA error, etc.)
  RESTRICTED // account was ACTIVE but is now temporarily limited (WhatsApp "in review" / rate-limited) — usually self-recovers in ~24h
  BANNED // account was ACTIVE but is now permanently banned/suspended (BanAppealActivity, "This account can't use WhatsApp")
  LOGGED_OUT // account got logged out on-device ("You're logged out" / number registered elsewhere) — needs re-registration
}

model GeneratedAccount {
  id       String                 @id @default(cuid())
  batchId  String? // groups accounts created in one batch run
  platform String // whatsapp | instagram | facebook
  status   GeneratedAccountStatus @default(PENDING)

  // Identity (from the identity provider).
  firstName   String?
  lastName    String?
  gender      String?
  birthDate   String? // ISO date
  countryCode String? // 2-letter

  // Contact + secrets (encrypted where sensitive).
  emailAddress String?
  username     String?
  passwordEnc  String? // encrypted
  phoneNumber  String?
  smsRequestId String? // provider's rental id (poll/cancel)
  otpCodeEnc   String? // encrypted once received

  // Where it ran + free-form notes.
  deviceId String?
  error    String?
  notes    String?

  // Live WhatsApp-registration progress: { log: [...], lastProgress: {...} }.
  // Persisted here (not on the Job) because Job.result is overwritten wholesale on
  // completion; keyed by account so the two register jobs share one panel history.
  registerLog Json?

  workspaceId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([batchId])
  @@index([status])
}
